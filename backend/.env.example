# Required, at least 32 characters. Generate .env with: uv run scripts/generate_env.py
JWT_SECRET=

# Required for the default endpoint (the challenge's Azure OpenAI): the team key. Never commit it.
# A local server usually needs none.
LLM_API_KEY=

# Optional, defaults shown
# JWT_EXPIRE_MINUTES=1440
# DATABASE_URL=sqlite:///./zetta.db
# CORS_ORIGINS=["http://localhost:5173"]
# Host names the server answers to (compose sets "backend" as well). Add the real name in production.
# ALLOWED_HOSTS=["localhost", "127.0.0.1"]
# Any OpenAI-compatible server, e.g. a local llama.cpp: http://192.168.1.51:9931/v1
# Plain http sends chat texts and letters unencrypted through the network: only on a network you trust.
# LLM_BASE_URL=https://aif-dvsv-dev-hackathon-01-we-12.services.ai.azure.com/openai/v1
# LLM_MODEL=gpt-5-4-mini
# Extra fields for every request. A local model that thinks first can use up the token limit and reply with nothing:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
